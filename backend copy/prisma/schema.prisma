generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model challan_items {
  id           Int       @id @default(autoincrement())
  challan_id   Int?
  product_id   Int?
  product_name String?   @db.VarChar(100)
  unit_price   Decimal?  @db.Decimal(10, 2)
  quantity     Int?
  challans     challans? @relation(fields: [challan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products     products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model challans {
  id             Int             @id @default(autoincrement())
  challan_number String?         @unique @db.VarChar(50)
  customer_id    Int?
  total_quantity Int?
  status         String?         @db.VarChar(20)
  created_by     Int?
  created_date   DateTime?       @default(now()) @db.Timestamp(6)
  challan_items  challan_items[]
  users          users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers      customers?      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model customers {
  id             Int        @id @default(autoincrement())
  customer_name  String?    @db.VarChar(100)
  mobile         String?    @db.VarChar(15)
  email          String?    @db.VarChar(100)
  business_name  String?    @db.VarChar(100)
  gst_number     String?    @db.VarChar(20)
  customer_type  String?    @db.VarChar(30)
  address        String?
  status         String?    @db.VarChar(20)
  follow_up_date DateTime?  @db.Date
  notes          String?
  challans       challans[]
}

model products {
  id              Int               @id @default(autoincrement())
  product_name    String?           @db.VarChar(100)
  sku             String?           @db.VarChar(50)
  category        String?           @db.VarChar(100)
  unit_price      Decimal?          @db.Decimal(10, 2)
  current_stock   Int?
  minimum_stock   Int?
  warehouse       String?           @db.VarChar(100)
  challan_items   challan_items[]
  stock_movements stock_movements[]
}

model stock_movements {
  id               Int       @id @default(autoincrement())
  product_id       Int?
  quantity_changed Int?
  movement_type    String?   @db.VarChar(10)
  reason           String?
  created_by       Int?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products         products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  email           String            @unique @db.VarChar(100)
  password        String            @db.VarChar(255)
  role            String            @db.VarChar(20)
  challans        challans[]
  stock_movements stock_movements[]
}
